<IfModule mod_rewrite.c>
    RewriteEngine On
    AcceptPathInfo On

    # Block direct access to sensitive folders and files
    RewriteRule ^(application|system|vendor|\.git|\.env|database\.sql) - [F,L]

    # Front Controller Rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

# Protect dot files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
